# Optional: override default data directory (required: no — defaults to ./.sdfr)
# SDFR_HOME=.sdfr

# Optional: log level for pino (required: no — default info)
# SDFR_LOG_LEVEL=info

# Optional: approval timeout seconds (required: no — default 120)
# SDFR_APPROVAL_TIMEOUT_SEC=120

# No API keys are required for sdfr core, fixture servers, or the REA JS analysis used in keyless e2e.
# Downstream MCP servers you wrap may need their own keys — those are yours, not this lab's.
